{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.exclude": {
    "_build": true,
    "node_modules": true
  },
  "search.exclude": {
    "_build": true,
    "node_modules": true,
    "backups": true
  },
  "files.associations": {
    "*.command": "shellscript"
  }
}
